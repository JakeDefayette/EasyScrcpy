{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasyScrcpy",
  "version": "0.1.3",
  "identifier": "com.simvs.easyscrcpy",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EasyScrcpy",
        "width": 480,
        "height": 640,
        "minWidth": 400,
        "minHeight": 500,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/scrcpy",
      "binaries/adb"
    ],
    "resources": {
      "binaries/AdbWinApi.dll": "AdbWinApi.dll",
      "binaries/AdbWinUsbApi.dll": "AdbWinUsbApi.dll",
      "binaries/SDL2.dll": "SDL2.dll",
      "binaries/libusb-1.0.dll": "libusb-1.0.dll",
      "binaries/avcodec-61.dll": "avcodec-61.dll",
      "binaries/avformat-61.dll": "avformat-61.dll",
      "binaries/avutil-59.dll": "avutil-59.dll",
      "binaries/swresample-5.dll": "swresample-5.dll",
      "binaries/scrcpy-server": "scrcpy-server"
    },
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
